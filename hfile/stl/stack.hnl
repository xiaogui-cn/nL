class stack<type T> {
    /*
     The stack defines five standard functions. Please refer to usebook.txt
     for details. Note that there are numerous known bugs and Undefined 
     Behaviors (UB) associated with these functions,
     so strictly follow the guidelines in usebook.txt when using them.
    */
    private:
        array T t[];
        var int cap;
        var int it;
        
    public:
        stack() {
            this.cap = 5;
            this.it = 0;
            
            alloc buf << T[this.cap];
            this.t = buf;
        }
        
        /// PUSH: Push value to stack
        /// RETURN: void
        function push(T _x) -> void { 
            if(this.it +1 > this.cap) {
                var int newCap = this.cap + 10;
                alloc newArr << T[newCap];
                for(var int i=0; i < this.cap; i = i + 1) {
                    newArr[i] = this.t[i];
                }
                this.cap = newCap;
                this.t = newArr;
            }
            
            this.t[this.it] = _x;
            this.it = this.it + 1;
        }
        
        /// POP: Pop value to stack
        /// RETURN: void
        function pop() -> void { this.it = this.it - 1; }
        
        /// TOP: Get first value to stack
        /// RETURN: T
        function top() -> T { return this.t[this.it - 1]; }
        
        /// EMPTY: Is the container empty?
        /// RETURN: bool
        function empty() -> bool { 
            if(this.it == 0)
                return true;
            else
                return false; 
        }
        
        /// SIZE: Container size
        /// RETURN: int
        function len() -> int { return this.it; }
} /* stack */