class vector<type T> {
    private:
        array T t[];
        var int cap;
        var int it;
        
    public:
        vector() {
            this.cap = 5;
            this.it = 0;
            
            alloc buf << T[this.cap];
            this.t = buf;
        }

        /// INIT: Init t[]
        /// RETURN: void
        function init() -> void {
            this.cap = 5;
            this.it = 0;
            
            alloc buf << T[5];
            this.t = buf;
        }

        /// PUSH: Push back to vector
        /// RETURN: void
        function push(T _x) -> void {
            if(this.it +1 > this.cap) {
                var int newCap = this.cap + 10;
                alloc newArr << T[newCap];
                for(var int i=0; i < this.cap; i = i + 1) {
                    newArr[i] = this.t[i];
                }
                this.cap = newCap;
                this.t = newArr;
            }
            
            this.t[this.it] = _x;
            this.it = this.it + 1;
        }
        
        function operator[](int idx) -> T {
            if(idx <= this.it)
                return this.t[idx];
            return _exit(1);
        }
        
        /// Front: Return the first element in the vector
        /// RETURN: T
        function front() -> T { return this.t[0]; }
        
        /// BACK: Return the last element in the vector.
        /// RETURN: T
        function back() -> T { return this.t[this.it - 1]; }
        
        /// EMPTY: Check if the container is empty
        /// RETURN: bool
        function empty() -> bool { 
            if(this.it == 0)
                return true;
            else
                return false;
        }
        
        /// LEN: Return vector's size
        /// RETURN: int
        function len() -> int { return this.it; }
        
        /// CLEAR: Empty the container
        /// RETURN: void
        function clear() -> void { this.it = 0; }
        
        /// POP: Delete vector last value
        /// RETURN: void
        function pop() -> void { this.it = this.it - 1; }
        
        /// SWAP: Swap variable
        /// RETURN: void
        function swap(ref T a, ref T b) -> void{
            var T tmp = a;
            a = b;
            b = tmp;
        }
        
        /// SORT: Sort the array
        /// RETURN: void
        function sort(char c) -> void {
            for(var int i = 0; i < this.it - 1; i = i + 1) {
                var bool nswaped = true;
                for(var int j = 0; j < this.it - i - 1; j = j + 1) {
                    if(c == '<') {                  // Ascending order
                        if(this.t[j] > this.t[j+1])
                        {
                            var T tmp = this.t[j];
                            this.t[j] = this.t[j+1];
                            this.t[j+1] = tmp;
                            nswaped = false;
                        }
                    }
                    elif(c == '>') {                // Descending order
                        if(this.t[j] < this.t[j+1])
                        {
                            var T tmp = this.t[j];
                            this.t[j] = this.t[j+1];
                            this.t[j+1] = tmp;
                            nswaped = false;
                        }
                    }
                    else { return; }
                    
                    if(nswaped) 
                        return;
                }
            }
        }
} /* vector */