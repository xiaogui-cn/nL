/*
  This header defines input and output functions that simplify the
  cumbersome '_windows_cmd_print' and '_windows_cmd_cin' operations.
  Please refer to 'readme.txt'<> for details.
*/

function print(auto /* use auto to match different variable types */ __str) -> void {
    _windows_cmd_print(__str);
}

function input(ref /* use ref to reference variables */ auto __in) -> auto {
    __in = _windows_cmd_cin("");
}