var float e = 1.414;
var float pi = 3.141;

function pow(int x, int y) -> int {
    var int c = x;
    for(var int i = 1; i < y; i = i+1)
    {c = c * x;}
    return c;
}


function is_prime(int n) -> bool {
    if (n <= 1) return false; 
    
    if (n == 2) return true; 
    
    if (n % 2 == 0) return false; 

    for (var int i = 3; i * i <= n; i = i + 2) {
        if (n % i == 0) 
            return false;
    }
    
    return true;
}